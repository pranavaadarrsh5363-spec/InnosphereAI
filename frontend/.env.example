# InnoSphere AI - Frontend Environment Variables
# API base URL for FastAPI backend
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
# For production: NEXT_PUBLIC_API_URL=https://innosphereai-backend.onrender.com/api/v1

# Google Identity Services Client ID
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_oauth_client_id_here.apps.googleusercontent.com

