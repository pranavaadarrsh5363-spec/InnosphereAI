# ==============================================================================
# InnoSphere AI — Backend Environment Configuration Example
# ==============================================================================

# Environment & Server
ENVIRONMENT=development                # development | testing | production
DEBUG=true                             # true in dev, false in prod
PORT=8000
HOST=0.0.0.0

# Security & Authentication
SECRET_KEY=generate-a-secure-random-32-character-secret-key-here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080      # 7 days
GOOGLE_CLIENT_ID=your_google_oauth_client_id_here.apps.googleusercontent.com

# Database Configuration
# Local SQLite Development:
DATABASE_URL=sqlite:///./innovation_platform.db
# Production PostgreSQL:
# DATABASE_URL=postgresql://innosphere_user:secure_password@localhost:5432/innosphere_db
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# AI Provider Configuration
GEMINI_API_KEY=your_google_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
AI_PROVIDER=gemini                     # gemini | openai | heuristic
AI_TIMEOUT_SECONDS=15.0

# Semantic & Vector Search Configuration
EMBEDDING_PROVIDER=auto                # auto | gemini | deterministic
EMBEDDING_MODEL=text-embedding-004
EMBEDDING_DIMENSIONS=768
VECTOR_SEARCH_BACKEND=auto             # auto | pgvector | in_memory
HYBRID_WEIGHT_SEMANTIC=0.50
HYBRID_WEIGHT_KEYWORD=0.25
HYBRID_WEIGHT_METADATA=0.15
HYBRID_WEIGHT_QUALITY=0.10
AI_RERANK_TOP_N=10

# External Research Connectors (Optional for higher rate limits)
GITHUB_TOKEN=your_github_personal_access_token_here
SEMANTIC_SCHOLAR_KEY=your_semantic_scholar_api_key_here
EXTERNAL_API_TIMEOUT_SECONDS=8.0

# CORS Allowed Origins (Comma-separated list)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Rate Limiting (Requests per minute per client)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_GLOBAL_PER_MIN=120
RATE_LIMIT_AUTH_PER_MIN=25
RATE_LIMIT_AI_PER_MIN=20
RATE_LIMIT_SEARCH_PER_MIN=40
